# Set these as hosting secrets, never in a public repository.
ADMIN_KEY=
VIEW_KEY=
LORAII_RELAY_KEY=
PORT=10000
LORAII_DATA_DIR=/tmp/loraii-online
PERSISTENT_STORAGE=0
# Optional: your canonical HTTPS hostname. Otherwise detected from the hosting proxy.
PUBLIC_URL=
# Optional: configure the five SE overlay URLs through the protected controller instead.
SE_URLS_JSON={}
